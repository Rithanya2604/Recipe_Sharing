# Copy this file to .env and fill in your own values.

# Local MongoDB:      mongodb://127.0.0.1:27017/yummyshare
# MongoDB Atlas:       mongodb+srv://<user>:<password>@<cluster-url>/yummyshare?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/yummyshare

# Any long random string — used to sign login tokens
JWT_SECRET=replace_with_a_long_random_secret

PORT=5000
